<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.PanelHistorialController">
    <children>
        <Label layoutX="30.0" layoutY="25.0" text="Historial de Operaciones - UPVM">
            <font>
                <Font name="System Bold" size="22.0" />
            </font>
        </Label>

        <TableView fx:id="tablaHistorial" layoutX="30.0" layoutY="80.0" prefHeight="420.0" prefWidth="740.0">
            <columns>
                <TableColumn fx:id="colTipo" prefWidth="200.0" text="Tipo de Acción" />
                <TableColumn fx:id="colDetalle" prefWidth="539.0" text="Detalle de la Operación" />
            </columns>
        </TableView>

        <Button layoutX="30.0" layoutY="520.0" mnemonicParsing="false" onAction="#deshacerAccion" prefHeight="30.0" prefWidth="150.0" style="-fx-background-color: #c0392b; -fx-text-fill: white;" text="Deshacer Última Acción" />
    </children>
</AnchorPane>