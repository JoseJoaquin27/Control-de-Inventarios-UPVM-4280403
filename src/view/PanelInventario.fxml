<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.PanelInventarioController">
    <children>
        <Label layoutX="30.0" layoutY="25.0" text="Gestión de Inventario - UPVM">
            <font>
                <Font name="System Bold" size="22.0" />
            </font>
        </Label>
        <TableView fx:id="tablaInventario" layoutX="30.0" layoutY="80.0" prefHeight="330.0" prefWidth="740.0">
            <columns>
                <TableColumn fx:id="colId" prefWidth="80.0" text="ID" />
                <TableColumn fx:id="colNombre" prefWidth="280.0" text="Nombre" />
                <TableColumn fx:id="colCategoria" prefWidth="230.0" text="Categoría" />
                <TableColumn fx:id="colExistencias" prefWidth="149.0" text="Existencias" />
            </columns>
        </TableView>

        <TextField fx:id="txtId" layoutX="30.0" layoutY="440.0" prefWidth="80.0" promptText="ID (núm)" />
        <TextField fx:id="txtNombre" layoutX="125.0" layoutY="440.0" prefWidth="200.0" promptText="Nombre del material" />
        <TextField fx:id="txtCategoria" layoutX="340.0" layoutY="440.0" prefWidth="170.0" promptText="Categoría" />
        <TextField fx:id="txtExistencias" layoutX="525.0" layoutY="440.0" prefWidth="90.0" promptText="Stock" />

        <Button layoutX="635.0" layoutY="440.0" mnemonicParsing="false" onAction="#agregarMaterial" prefHeight="25.0" prefWidth="135.0" style="-fx-background-color: #2c3e50; -fx-text-fill: white;" text="Agregar a Lista" />
    </children>
</AnchorPane>