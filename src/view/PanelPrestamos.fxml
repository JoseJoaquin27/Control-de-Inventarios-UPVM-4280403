<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.PanelPrestamosController">
    <children>
        <Label layoutX="30.0" layoutY="25.0" text="Control de Préstamos - UPVM">
            <font>
                <Font name="System Bold" size="22.0" />
            </font>
        </Label>

        <TableView fx:id="tablaPrestamos" layoutX="30.0" layoutY="80.0" prefHeight="330.0" prefWidth="740.0">
            <columns>
                <TableColumn fx:id="colFolio" prefWidth="90.0" text="Folio" />
                <TableColumn fx:id="colMaterialId" prefWidth="120.0" text="ID Material" />
                <TableColumn fx:id="colCantidad" prefWidth="120.0" text="Cantidad" />
                <TableColumn fx:id="colEstudiante" prefWidth="409.0" text="Estudiante" />
            </columns>
        </TableView>

        <TextField fx:id="txtFolio" layoutX="30.0" layoutY="440.0" prefWidth="80.0" promptText="Folio" />
        <TextField fx:id="txtMaterialId" layoutX="120.0" layoutY="440.0" prefWidth="100.0" promptText="ID Material" />
        <TextField fx:id="txtCantidad" layoutX="230.0" layoutY="440.0" prefWidth="90.0" promptText="Cantidad" />
        <TextField fx:id="txtEstudiante" layoutX="330.0" layoutY="440.0" prefWidth="210.0" promptText="Nombre del estudiante" />

        <Button layoutX="555.0" layoutY="440.0" mnemonicParsing="false" onAction="#encolarPrestamo" prefHeight="25.0" prefWidth="100.0" style="-fx-background-color: #2c3e50; -fx-text-fill: white;" text="Encolar" />
        <Button layoutX="665.0" layoutY="440.0" mnemonicParsing="false" onAction="#atenderPrestamo" prefHeight="25.0" prefWidth="105.0" style="-fx-background-color: #c0392b; -fx-text-fill: white;" text="Atender (FIFO)" />
    </children>
</AnchorPane>