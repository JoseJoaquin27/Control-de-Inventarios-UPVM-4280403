        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;\nclassDiagram\ndirection TB\n\nclass Usuario {\n  -int idUsuario\n  -String nombre\n  -String correo\n  -String contrasena\n  -String rol\n  +iniciarSesion()\n  +consultarInventario()\n  +registrarMovimiento()\n}\n\nclass Producto {\n  -int idProducto\n  -String codigo\n  -String nombre\n  -String descripcion\n  -int stockActual\n  -int stockMinimo\n  -String unidad\n  -String estado\n  +registrarProducto()\n  +actualizarProducto()\n  +consultarProducto()\n  +actualizarStock()\n}\n\nclass Categoria {\n  -int idCategoria\n  -String nombre\n  -String descripcion\n  +registrarCategoria()\n  +modificarCategoria()\n  +consultarCategoria()\n}\n\nclass Proveedor {\n  -int idProveedor\n  -String nombre\n  -String contacto\n  -String telefono\n  +registrarProveedor()\n  +modificarProveedor()\n  +consultarProveedor()\n}\n\nclass MovimientoInventario {\n  -int idMovimiento\n  -Date fecha\n  -String tipo\n  -int cantidad\n  -String motivo\n  +registrarEntrada()\n  +registrarSalida()\n  +registrarAjuste()\n  +consultarMovimiento()\n}\n\nCategoria \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Producto : clasifica\nProveedor \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Producto : suministra\nProducto \&quot;1\&quot; --&gt; \&quot;0..*\&quot; MovimientoInventario : registra\nUsuario \&quot;1\&quot; --&gt; \&quot;0..*\&quot; MovimientoInventario : realiza\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="tReNgizaQCVwgLIbxCo5-1">
